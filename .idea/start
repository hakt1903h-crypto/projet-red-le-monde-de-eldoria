// Codes couleur ANSI pour l'ambiance Dark Fantasy & Restauration du monde
const (
	ColorReset   = "\033[0m"
	ColorRed     = "\033[31m"      // Danger / Sang
	ColorDkRed   = "\033[38;5;52m" // Rouge sombre / Oubli
	ColorGray    = "\033[90m"      // Monde sans couleurs / Ombres
	ColorGold    = "\033[38;5;136m"// Souvenir retrouvé / Ancien éclat
	ColorCyan    = "\033[36m"      // Mystère
	ColorBgDark  = "\033[40m"      // Fond noir terminal
)

// Structure représentant l'état du joueur et du monde
type GameState struct {
	PlayerName  string
	Class       string
	Memories    int
	WorldColor  string
}

func clearScreen() {
	var cmd *exec.Cmd
	if runtime.GOOS == "windows" {
		cmd = exec.Command("cmd", "/c", "cls")
	} else {
		cmd = exec.Command("clear")
	}
	cmd.Stdout = os.Stdout
	cmd.Run()
}

// Affiche du texte avec un effet de sténographie ténébreuse
func printSlow(text string, delay time.Duration, color string) {
	for _, char := range text {
		fmt.Printf("%s%c%s", color, char, ColorReset)
		time.Sleep(delay)
	}
	fmt.Println()
}

