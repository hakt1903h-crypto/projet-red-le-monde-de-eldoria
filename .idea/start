package main

import (
	"fmt"
	"strings"

	tea "github.com/charmbracelet/bubbletea"
)

type model struct {
	cursor, width, height int
	state                 string
}

func (m model) Init() tea.Cmd { return nil }

func (m model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	switch msg := msg.(type) {
	case tea.WindowSizeMsg:
		m.width, m.height = msg.Width, msg.Height
	case tea.KeyMsg:
		switch msg.String() {
		case "ctrl+c", "q":
			if m.state == "menu" {
				return m, tea.Quit
			}
			m.state = "menu"
		case "up", "k":
			if m.state == "menu" {
				m.cursor = (m.cursor + 2) % 3
			}
		case "down", "j":
			if m.state == "menu" {
				m.cursor = (m.cursor + 1) % 3
			}
		case "enter":
			if m.state == "menu" {
				switch m.cursor {
				case 0:
					m.state = "game"
				case 1:
					m.state = "settings"
				case 2:
					return m, tea.Quit
				}
			} else {
				m.state = "menu"
			}
		}
	}
	return m, nil
}

func (m model) View() string {
	if m.width == 0 {
		return ""
	}

	var lines []string
	if m.state == "menu" {
		// Titre avec des caractères standard (compatibles à 100% sur tous les terminaux)
		lines = append(lines,
			"\033[31m+-------------------------------------------+\033[0m",
			"\033[31m|     ELDORIA — LES FRAGMENTS DU SOUVENIR     |\033[0m",
			"\033[31m+-------------------------------------------+\033[0m",
			"\033[90m\"Plus il retrouve ses souvenirs, plus le monde se colore...\"\033[0m",
			"",
			"",
		)

		// Les cases / boutons interactifs
		opts := []string{"[  JOUER  ]", "[ PARAMÈTRES DE TOUCHES ]", "[   EXIT  ]"}
		for i, o := range opts {
			if m.cursor == i {
				lines = append(lines, fmt.Sprintf("\033[41m\033[97m > %s < \033[0m", o))
			} else {
				lines = append(lines, fmt.Sprintf("\033[38;5;52m   %s   \033[0m", o))
			}
		}
		lines = append(lines, "", "", "\033[90m[↑↓] Naviguer | [ENTRÉE] Valider | [q] Quitter\033[0m")
	} else if m.state == "game" {
		lines = []string{
			"\033[31m=== EXPÉDITION ===\033[0m",
			"Vous vous réveillez au cœur de la forêt d'Eldoria...",
			"\033[38;5;136mAppuyez sur Entrée pour retourner au menu.\033[0m",
		}
	} else {
		lines = []string{
			"\033[31m=== PARAMÈTRES DE TOUCHES ===\033[0m",
			"Navigation : [↑/↓] | Valider : [Entrée] | Quitter : [Q]",
			"\033[38;5;136mAppuyez sur Entrée pour retourner au menu.\033[0m",
		}
	}

	// Centrage vertical dynamique
	topPad := (m.height - len(lines)) / 2
	if topPad < 0 {
		topPad = 0
	}

	var sb strings.Builder
	sb.WriteString(strings.Repeat("\n", topPad))

	// Centrage horizontal de chaque ligne
	for _, line := range lines {
		plainLen := stripAnsi(line)
		leftPad := (m.width - plainLen) / 2
		if leftPad < 0 {
			leftPad = 0
		}
		sb.WriteString(strings.Repeat(" ", leftPad) + line + "\n")
	}
	return sb.String()
}

func stripAnsi(s string) int {
	inAnsi, length := false, 0
	for i := 0; i < len(s); i++ {
		if s[i] == '\033' {
			inAnsi = true
			continue
		}
		if inAnsi {
			if s[i] == 'm' {
				inAnsi = false
			}
			continue
		}
		length++
	}
	return length
}

func main() {
	tea.NewProgram(model{}, tea.WithAltScreen()).Run()
}

